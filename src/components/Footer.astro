---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border flex flex-col items-start border-t py-6 sm:py-4">
    <div class="text-muted-foreground my-2 text-xs whitespace-nowrap">
      <span>{t.footer.copyright} &#169; {currentYear}</span>
    </div>
  </div>
</footer>
