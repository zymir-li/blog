---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  layout?: "feed" | "index";
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  layout = "feed",
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, ...props } = data;
---

{
  layout === "index" ? (
    <li>
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class="group focus-outline block py-5 sm:py-6"
      >
        <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
          <div class="flex min-w-0 items-center gap-3">
            <Heading
              transition:name={toTransitionName(id)}
              class="text-accent text-xl leading-snug font-semibold tracking-tight group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4"
            >
              {title}
            </Heading>
            {data.draft && (
              <span class="text-muted-foreground shrink-0 text-[0.62rem] tracking-wider uppercase">
                Draft
              </span>
            )}
          </div>
          <Datetime
            {...props}
            showIcon={false}
            class="shrink-0 sm:justify-end"
          />
        </div>
        <p class="text-muted-foreground mt-3 max-w-[64ch] text-sm leading-6 sm:text-base">
          {description}
        </p>
      </a>
    </li>
  ) : (
    <li class="my-6">
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class:list={[
          "text-accent inline-block text-lg font-medium",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading transition:name={toTransitionName(id)}>{title}</Heading>
      </a>
      <Datetime {...props} />
      <p class="max-w-[68ch] leading-7">{description}</p>
    </li>
  )
}
