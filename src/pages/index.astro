---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Socials from "@/components/Socials.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const recentPosts = getSortedPosts(posts).slice(0, 4);
const homePath = getRelativeLocaleUrl(locale, "");
const postsPath = getRelativeLocaleUrl(locale, "posts");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section class="border-border border-b py-10 sm:py-12">
      <div>
        <h1
          aria-label="Zymir"
          class="text-4xl font-bold tracking-tight sm:text-5xl"
        >
          <span aria-hidden="true">
            <span class="text-accent">&gt;</span>Zymir<span
              class="terminal-cursor text-accent">_</span
            >
          </span>
        </h1>
        <p class="mt-4 max-w-3xl leading-7">
          Building software, learning broadly, and following interesting
          problems.
        </p>
        <p class="text-muted-foreground mt-2 text-sm">
          All posts are written without AI-generated content.
        </p>
        <div class="mt-4">
          <Socials />
        </div>
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <section class="py-8">
          <h2 class="text-2xl font-semibold">Recent posts</h2>
          <ul class="mt-4">
            {recentPosts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
          <a
            href={postsPath}
            class="text-accent mt-6 inline-block font-medium decoration-dashed underline-offset-4 hover:underline"
          >
            View all →
          </a>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<style>
  .terminal-cursor {
    animation: terminal-blink 1.15s steps(1, end) infinite;
  }

  @keyframes terminal-blink {
    0%,
    48% {
      opacity: 1;
    }
    49%,
    100% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-cursor {
      animation: none;
    }
  }
</style>
